<%- layout('layouts/boilerplate') %>

<% if (typeof search !== 'undefined') { %>
    <p class="text-center mt-3">
        <% if (list.length === 0) { %>
            No results found for "<%= search %>" 
            <a href="/listings">View all listings</a>
        <% } else { %>
            <%= list.length %> result(s) for "<%= search %>"
        <% } %>
    </p>
<% } %>
<style>
    #tabs{
        display: flex;
        column-gap: 1rem;
        margin-top: 1rem;
    }
    .tab{
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 0.4rem solid transparent;
        transition: border-color 0.3s linear(0 0%, 0 1.8%, 0.01 3.6%, 0.03 6.35%, 0.07 9.1%, 0.13 11.4%, 0.19 13.4%, 0.27 15%, 0.34 16.1%, 0.54 18.35%, 0.66 20.6%, 0.72 22.4%, 0.77 24.6%, 0.81 27.3%, 0.85 30.4%, 0.88 35.1%, 0.92 40.6%, 0.94 47.2%, 0.96 55%, 0.98 64%, 0.99 74.4%, 1 86.4%, 1 100%);
        width: 4vw;
    }
    .tab a i{color: #da1249;}
    .tab a {
        text-decoration: none;
        color: black;
    }
    .tab:hover, .tab:focus {border-color: #333333ab;}
</style>

<div id="tabs">
    <div class="tab">
        <a type="button" id="tab-all">All</a>
    </div>
    <div class="tab">
        <a type="button" id="tab-home"><i class="fa-solid fa-house-chimney"></i> Home</a>
    </div>
    <div class="tab">
        <a type="button" id="tab-hotel"><i class="fa-solid fa-hotel"></i> Hotel</a>
    </div>
</div>

<%- include('includes/flash.ejs') %>
 
<div class="listing-cards container-md">
    <div class="row g-4">
        <% for(let item of list) { %>
            <div class="col-lg-4 col-md-6 col-12 listing-item" data-property-type="<%= item.propertyType %>">
                <div class="card listed-card">
                    <div class="listing-img-container">
                        <a href="/listings/<%- item._id %>"><img 
                            src='<%= item.image.url %>' 
                            class="card-img-top list-card-img" 
                            alt="<%= item.title %>"
                            loading="lazy"
                        ></a>
                        <button type="button" class="wishlistBtn">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                    </div>
                    <div class="card-body">
                        <a href="/listings/<%- item._id %>"><h6 class="card-title"><%- item.title %></h6></a>
                        <p class="card-text">₹<%- item.price.toLocaleString("en-in") %> / night</p>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</div>