<%- layout('layouts/boilerplate') %>

<% if (typeof search !== 'undefined') { %>
    <p class="text-center mt-3">
        <% if (list.length === 0) { %>
            No results found for "<%= search %>" 
            <a href="/listings">View all listings</a>
        <% } else { %>
            <%= list.length %> result(s) for "<%= search %>"
        <% } %>
    </p>
<% } %>
<style>
    #filters{
        display: flex;
        column-gap: 0.2rem;
        margin-top: 1rem;
    }
    .filter{
        display: flex;
        flex-direction: column;
        align-items: center;
    }
</style>

<div id="filters">
    <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>
    <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>
    <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>
</div>
<div class="listing-cards container-md">
    <div class="row g-4">
        <% for(let item of list) { %>
            <div class="col-lg-4 col-md-6 col-12">
                <div class="card listed-card">
                    <div class="listing-img-container">
                        <a href="/listings/<%- item._id %>"><img 
                            src='<%= item.image.url %>' 
                            class="card-img-top list-card-img" 
                            alt="<%= item.title %>"
                            loading="lazy"
                        ></a>
                        <button type="button" class="wishlistBtn">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                    </div>
                    <div class="card-body">
                        <a href="/listings/<%- item._id %>"><h6 class="card-title"><%- item.title %></h6></a>
                        <p class="card-text">₹<%- item.price.toLocaleString("en-in") %> / night</p>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</div>